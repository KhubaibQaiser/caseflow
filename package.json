{
  "name": "caseflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && node scripts/check-no-color-literals.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "size": "node scripts/check-bundle-size.mjs",
    "e2e": "playwright test --trace off",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx scripts/seed.ts",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts && prettier --write lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "date-fns": "4.4.0",
    "libphonenumber-js": "1.13.16",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "nuqs": "2.10.3",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
